    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
